# Copy this file to deploy/portainer/env.chat.production and replace every CHANGE_ME.
# Do not commit the copied file: it contains passwords and the RSA public key.

IMAGE_REGISTRY=ghcr.io
IMAGE_OWNER=lensexe
IMAGE_TAG=latest
CHAT_IMAGE=ghcr.io/lensexe/lens-chat-service:latest
CHAT_PULL_POLICY=always

SERVER_ADDRESS=:8080
SERVER_MODE=release
SERVER_SHUTDOWN_TIMEOUT=10s

# Created by lens-mongodb-init in the shared lens-infra stack.
MONGO_DATABASE=chat_direct
MONGO_URI=mongodb://lens-chat:CHANGE_ME_MONGO_CHAT_PASSWORD@chat-mongodb:27017/?authSource=chat_direct

KEYCLOAK_ISSUER=https://auth.lens.id.vn/realms/lens
# Match the aud claim issued by the lens-be client.
KEYCLOAK_AUDIENCE=lens-be
KEYCLOAK_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_REAL_RSA_PUBLIC_KEY\n-----END PUBLIC KEY-----'

AUTH_DISABLED=false
AUTH_DEFAULT_USER_ID=
CORS_ALLOW_ORIGINS=https://app.lens.id.vn

KAFKA_BROKERS=kafka:9094
KAFKA_CLIENT_ID=chat-service
KAFKA_CHAT_EVENTS_TOPIC=chat.conversation.events.v1
KAFKA_USERNAME=kafka
KAFKA_PASSWORD=CHANGE_ME_KAFKA_PASSWORD
KAFKA_SSL=false
KAFKA_OUTBOX_POLL_INTERVAL=1s
KAFKA_OUTBOX_LEASE_DURATION=30s
KAFKA_PUBLISH_TIMEOUT=10s
