meta {
  name: login
  type: http
  seq: 5
}

post {
  url: http://localhost:3000/api/v1/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "REPLACE_WITH_LOGIN_EMAIL",
    "password": "REPLACE_WITH_LOGIN_PASSWORD"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
